      "schema": "ConsumeInput",
      "valid": true,
      "errors": []
    },
    {
      "route": "POST /consumption",
      "schema": "Lookup",
      "valid": true,
      "errors": []
    },
    {
      "route": "POST /purchase/query",
      "schema": "Lookup",
      "valid": true,
      "errors": []
    },
    {
      "route": "POST /purchases/list",
      "schema": "ListInput",
      "valid": true,
      "errors": []
    },
    {
      "route": "POST /consumptions/list",
      "schema": "ListInput",
      "valid": true,
      "errors": []
    },
    {
      "route": "PUT /webhook",
      "schema": "WebhookInput",
      "valid": true,
